# Copie para .env (cp .env.example .env) e troque os placeholders. Nunca versione o .env.

# --- docker compose (SQL Server 2022) ---
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04
# Senha forte (mín. 8 caracteres com maiúscula, minúscula, número e símbolo). Use a mesma na connection string.
MSSQL_SA_PASSWORD=<defina-uma-senha-forte>
MSSQL_PORT=1433

# --- API (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__ForgeFeast=Server=localhost,1433;Database=ForgeFeast;User Id=sa;Password=<mesma-senha-do-MSSQL_SA_PASSWORD>;TrustServerCertificate=True
Database__ApplyMigrationsOnStartup=true

# --- Pedidos (F02, ADR-015): corte e fuso. Para a demo, use 00:00 (pedidos encerrados) ou 23:59 (abertos) ---
# Ordering__CutoffTime=12:00
# Ordering__TimeZone=America/Sao_Paulo
